# Supabase - public browser settings (safe to expose with proper RLS policies)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Email of the single academy admin account in Supabase Auth.
# This is not a secret; the password is stored only in Supabase Auth.
VITE_ADMIN_EMAIL="admin@example.com"

# Existing project settings
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
